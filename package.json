{
  "name": "karin-plugin-adapter-douyin",
  "version": "1.1.0",
  "author": "shijin",
  "type": "module",
  "description": "karin 抖音适配器",
  "homepage": "https://github.com/KarinJS/karin",
  "bugs": {
    "url": "https://github.com/KarinJS/karin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarinJS/karin.git"
  },
  "scripts": {
    "app": "node dist/app.js",
    "build": "tsdown",
    "dev": "cross-env EBV_FILE=\"development.env\" node --import tsx src/app.ts",
    "pub": "npm publish --access public"
  },
  "main": "dist/index.js",
  "dependencies": {
    "@karinjs/plugin-shotium": "^0.3.2",
    "@ys7zts/karin-plugin-nekostatus": "^1.4.13",
    "karin-plugin-botweb": "^1.0.15",
    "karin-plugin-qbot": "^1.0.11",
    "protobufjs": "^8.8.0",
    "qrcode": "^1.5.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/lodash": "^4.17.16",
    "@types/node": "^20.17.8",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.7.0",
    "neostandard": "^0.11.9",
    "node-karin": "^1.17.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3"
  },
  "karin": {
    "main": "src/index.ts",
    "apps": [
      "dist/apps"
    ],
    "ts-apps": [
      "src/apps"
    ],
    "static": [
      "resources"
    ],
    "files": [
      "config",
      "data",
      "resources"
    ]
  },
  "files": [
    "/dist/**/*.js",
    "/dist/**/*.d.ts",
    "/config/*.json",
    "resources",
    "!dist/app.js",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}